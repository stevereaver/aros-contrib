 /*
+ * AROS - uses bsdsocket.library, so sockets are NOT POSIX file descriptors.
+ * recv/send/CloseSocket must be used for network I/O.
+ */
+#ifdef AROS
+/* Undefine BOOL/BOOLEAN before pulling in exec/types.h via bsdsocket,
+ * to avoid conflicting types with Lynx's own typedef char BOOLEAN. */
+#ifdef BOOL
+#undef BOOL
+#endif
+#ifdef BOOLEAN
+#undef BOOLEAN
+#endif
+#include <proto/bsdsocket.h>
+/* Restore Lynx's BOOLEAN = char after exec/types.h has been included */
+#undef  BOOLEAN
+#undef  BOOL
+typedef char BOOLEAN;
+#define BOOL BOOLEAN
+#undef  NETREAD
+#undef  NETWRITE
+#undef  NETCLOSE
+#undef  IOCTL
+#define NETREAD(s,b,l)   recv((s),(b),(l),0)
+#define NETWRITE(s,b,l)  send((s),(b),(l),0)
+#define NETCLOSE(s)      CloseSocket(s)
+#define IOCTL(s,cmd,arg) IoctlSocket((s),(cmd),(APTR)(arg))
+/* Errno() is not an lvalue; use a static so SET_EINTR = EINTR compiles */
+extern int aros_socket_errno;
+#undef  SOCKET_ERRNO
+#define SOCKET_ERRNO aros_socket_errno
+#undef  GOT_SYSTEM
+#undef  GOT_PIPE
+#endif /* AROS */
